  "narrative": {
    "northStar": "The Session Chart",
    "overview": "The app looks and reads like a paper chart on a music stand. Black ground, white numbers, nothing between the player and the next bar. The players use it mid-set on a dark, loud stage, one hand on the phone, reading at arm's length (see PRODUCT.md). Every decision answers one question: does this help them read the next bar faster?\n\nMood: **sharp, quiet, certain.** Nothing on screen competes with the numbers. The app is dark everywhere. The only light surface is stage mode's \"Light\" paper look for daylight gigs. Color is rare and means something: amber marks what is live right now, red marks an error, and inside a chart, color is notation.",
    "keyCharacteristics": [
      "Black and white first; one accent (Downbeat Amber) used sparingly.",
      "Flat: no shadows, gradients or blur. Separation by 1px lines and space.",
      "Two corner radii: square (0px) for surfaces, 4px for controls.",
      "Big, bold, legible chart type with tabular figures.",
      "Tap targets of 44px or larger everywhere.",
      "Plain, short words."
    ],
    "rules": [
      {
        "name": "The Downbeat Rule",
        "body": "In the app's UI, amber means \"live right now\" and nothing else. If an element is not the current bar, the main action, an active toggle or the beat light, it is not amber. Chart notation is the one named exception (see above).",
        "section": "colors"
      },
      {
        "name": "The Stop Rule",
        "body": "Red appears only for errors and destructive actions, plus the stop mark inside charts. Never for emphasis.",
        "section": "colors"
      },
      {
        "name": "The No-Purple Rule",
        "body": "No purple, violet or indigo anywhere. A personal flag on a chord is a solid Chart White dot with a Stage Black ring.",
        "section": "colors"
      },
      {
        "name": "The Word-First Status Rule",
        "body": "Status reads from the word, not the color. Verified is Chart White text with a check mark. Unverified is a Cue Gray outline dot. Neither uses green or amber.",
        "section": "colors"
      },
      {
        "name": "The Arm's-Length Rule",
        "body": "No UI text below 14px. Chart text never below 30px in stage mode.",
        "section": "typography"
      },
      {
        "name": "The Two-Voice Rule",
        "body": "Geist speaks for the app, Atkinson speaks for the chart. Don't swap them.",
        "section": "typography"
      },
      {
        "name": "The Flat Stage Rule",
        "body": "Nothing floats. If a surface needs to stand apart, it changes ground color or gets a 1px line, never a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the `--bb-*` tokens from `app/globals.css` for every color, font, radius and spacing value.",
      "**Do** keep amber for what is live right now (the Downbeat Rule).",
      "**Do** keep every tap target at 44px or larger and UI text at 14px or larger.",
      "**Do** separate with 1px Rule Gray lines and space, not boxes.",
      "**Do** say status in words."
    ],
    "donts": [
      "**Don't** use gradient heroes or gradient text.",
      "**Don't** use emoji as icons.",
      "**Don't** put rounded cards everywhere; lists are rows, surfaces are square.",
      "**Don't** use generic purple accents (the No-Purple Rule).",
      "**Don't** center everything; text is left-aligned.",
      "**Don't** add a kicker or eyebrow label above a heading.",
      "**Don't** nest a card or panel inside another.",
      "**Don't** use same-size icon + heading + text cards as page structure.",
      "**Don't** use the hero-metric template (big number, small label, supporting stats).",
      "**Don't** use glass, blur or shadows, including hard offset shadows.",
      "**Don't** put a colored border thicker than 1px on one side of a card, row or alert.",
      "**Don't** use monospace as a costume; Geist Mono is for keys, bar counts, tempos and times.",
      "**Don't** add a light mode outside stage mode.",
      "**Don't** hard-code colors or fonts in components."
    ]
  }
}
